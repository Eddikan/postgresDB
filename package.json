{
  "name": "primefrontier",
  "version": "1.0.0",
  "description": "Node.js TypeScript backend with Fastify, PostgreSQL, and comprehensive authentication",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:lambda": "tsc --noEmit false --skipLibCheck || true && cd fastify-lambda && tsc",
    "dev": "nodemon",
    "start": "node dist/server.js",
    "render:build": "npm ci --legacy-peer-deps && npm run build",
    "render:start": "npm run db:setup && node dist/server.js",
    "lambda:deploy": "cd fastify-lambda && ./predeploy.sh && serverless deploy",
    "lambda:deploy:prod": "cd fastify-lambda && ./predeploy.sh && serverless deploy --stage production",
    "lambda:deploy:quick": "cd fastify-lambda && ./predeploy.sh && serverless deploy",
    "lambda:offline": "npm run build:lambda && cd fastify-lambda && serverless offline",
    "lambda:logs": "cd fastify-lambda && serverless logs -f api -t",
    "lambda:info": "cd fastify-lambda && serverless info",
    "db:create": "ts-node scripts/create-db-schema.ts",
    "db:seed": "ts-node scripts/seed-database.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "migration:create": "sequelize-cli migration:generate --name",
    "migration:run": "sequelize-cli db:migrate",
    "db:setup": "npm run migration:run && npm run db:seed:all",
    "db:fresh": "npm run db:migrate:undo:all && npm run db:setup",
    "seed": "npm run db:create && npm run db:seed",
    "test": "ts-node tests/basic.test.ts",
    "test:logger": "ts-node tests/logger-test.ts",
    "test:lint": "echo \"Linting...\" && echo \"✅ No linting configured yet\"",
    "test:build": "npm run build && echo \"✅ Build test passed\"",
    "docker:build": "docker build -t primefrontier-backend .",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "docker:stop": "docker compose down",
    "docker:stop-dev": "docker compose -f docker-compose.dev.yml down",
    "docker:clean": "docker compose down -v --remove-orphans && docker system prune -f"
  },
  "keywords": [
    "fastify",
    "typescript",
    "postgresql",
    "authentication",
    "2fa"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.925.0",
    "@aws-sdk/s3-request-presigner": "^3.925.0",
    "@fastify/aws-lambda": "^6.1.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/express": "^4.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@types/formidable": "^3.4.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^11.0.0",
    "aws-lambda-fastify": "^2.2.0",
    "bcrypt": "^6.0.0",
    "country-state-city": "^3.2.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "fastify-multer": "^2.0.3",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^4.2.0",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "sequelize-typescript": "^2.1.6",
    "speakeasy": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "twilio": "^5.10.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.156",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sequelize": "^4.28.20",
    "@types/speakeasy": "^2.0.10",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "serverless-offline": "^14.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
